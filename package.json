  "scripts": {
    "dev": "vite",
    "dev:local-api": "VITE_APP_BACKEND_API_URL=http://127.0.0.1:9900 vite",
    "basket:discover-presets": "node scripts/discover-basket-presets.mjs",
    "basket:download-logos": "node scripts/download-basket-logos.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern dev-dist --ignore-pattern ios/App/App/public --ignore-pattern android/app/src/main/assets/public",
    "app:sync": "npm run build-only && cap sync",
    "app:ios": "npm run app:sync && cap open ios",
    "app:android": "npm run app:sync && cap open android"
  },
